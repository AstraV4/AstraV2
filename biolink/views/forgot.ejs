<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title><%= t('forgot_h') %> · <%= siteName %></title>
<link rel="stylesheet" href="/static/css/app.css" />
</head>
<body>
<div class="container"><header><a href="/" class="logo"><%= siteName %></a></header></div>
<div class="auth-wrap">
  <% if (done) { %>
    <div class="auth panel">
      <h2><%= t('forgot_h') %> ✅</h2>
      <p class="sub"><%= t('forgot_done') %></p>
      <a class="btn btn-primary full" href="/login"><%= t('nav_login') %></a>
    </div>
  <% } else { %>
    <form class="auth panel" method="POST" action="/forgot">
      <h2><%= t('forgot_h') %></h2>
      <p class="sub"><%= t('forgot_sub') %></p>
      <% if (error) { %><div class="error"><%= error %></div><% } %>

      <label><%= t('f_email') %></label>
      <input type="email" name="email" placeholder="toi@exemple.com" required autofocus />

      <button class="btn btn-primary full" type="submit"><%= t('forgot_btn') %></button>
      <p class="muted"><a href="/login" style="color:var(--accent)"><%= t('nav_login') %></a></p>
    </form>
  <% } %>
</div>
</body>
</html>
